rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identity helpers ───────────────────────────────────────────────────────
    // Privilege comes ONLY from users/{uid}.role, which only admins can set
    // (owners cannot change it – see /users below). No hard-coded emails.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    // Leaders / GM / admins (matches the app's isLeader + admin roles)
    function isAdmin() {
      return myRole() in ['LEADER', 'GM', 'ADMIN', 'SUPER_ADMIN'];
    }



    // Any real team member (not a guest, not a self-signed-up account)
    function isStaff() {
      return isAdmin() || myRole() in ['BDM', 'ACCOUNT_MANAGER', 'AM'];
    }

    // New doc must be owned by the caller (admins may create on behalf of others)
    function createsOwn() {
      return isAdmin() || (isSignedIn() && request.resource.data.get('userId', null) == request.auth.uid);
    }

    // Existing doc belongs to caller
    function ownsExisting() {
      return isSignedIn() && resource.data.get('userId', null) == request.auth.uid;
    }

    // Non-admins can't move a doc to someone else
    function keepsOwner() {
      return request.resource.data.get('userId', null) == resource.data.get('userId', null);
    }

    // Standard owner-scoped collection
    function ownerRead() { return isAdmin() || ownsExisting(); }
    function ownerUpdate() { return isAdmin() || (isStaff() && ownsExisting() && keepsOwner()); }
    function ownerDelete() { return isAdmin() || (isStaff() && ownsExisting()); }
    function staffCreatesOwn() { return isAdmin() || (isStaff() && createsOwn()); }

    // ─── Data sharing (Access page) ─────────────────────────────────────────────
    // An admin shares an owner's data with a viewer (one-way, owner -> viewer) via
    // dataShares/{ownerId}_{viewerId} = { ownerId, viewerId, areas: { factFinding, whiteSpace,
    // callPlans, canvassing } }. A share grants FULL access (read, edit, delete) to the owner's
    // docs in that area. Fact Finding also covers the linked White Space + Call Plans.
    // Cost: one get() per evaluated request. Queries MUST constrain userId == ownerId.
    function hasShare(ownerId, areaA, areaB) {
      return isStaff()
        && ownerId is string
        && ownerId != request.auth.uid
        && exists(/databases/$(database)/documents/dataShares/$(ownerId + '_' + request.auth.uid))
        && (
          get(/databases/$(database)/documents/dataShares/$(ownerId + '_' + request.auth.uid)).data.areas.get(areaA, false) == true
          || get(/databases/$(database)/documents/dataShares/$(ownerId + '_' + request.auth.uid)).data.areas.get(areaB, false) == true
        );
    }
    function sharedWith(areaA, areaB) { return hasShare(resource.data.get('userId', null), areaA, areaB); }

    match /dataShares/{shareId} {
      // Admins manage shares; a viewer can read only the shares made TO them.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('viewerId', '') == request.auth.uid);
      allow create, update: if isAdmin()
        && request.resource.data.ownerId is string
        && request.resource.data.viewerId is string
        && request.resource.data.ownerId != request.resource.data.viewerId
        && shareId == request.resource.data.ownerId + '_' + request.resource.data.viewerId
        && request.resource.data.areas is map;
      allow delete: if isAdmin();
    }

    // ─── Users ──────────────────────────────────────────────────────────────────
    // Staff can read the team list; guests only their own doc.
    // Owners may update their own doc but never privilege fields.
    match /users/{userId} {
      allow read: if isOwner(userId)
        || isStaff()
        || (isSignedIn() && request.auth.token.email != null
            && resource.data.get('email', '') == request.auth.token.email);
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == 'GUEST'
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@teamglobalexp\\.com$')
      );
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'role', 'isGuest', 'email', 'territory', 'state', 'zones', 'target',
             'manualYtdTarget', 'assignedAgents', 'planType', 'specialisation',
             'salesforceUserId', 'isMock'
           ])
      );
      allow delete: if isAdmin();

      // Push notification tokens + preferences: owner only (Cloud Functions
      // use the Admin SDK). Not readable by admins or other staff.
      match /fcmTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096
          && request.resource.data.keys().hasOnly(['token', 'userAgent', 'createdAt', 'updatedAt']);
      }
      match /notificationSettings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && settingId == 'prefs'
          && request.resource.data.keys().hasOnly([
               'enabled', 'allowedStart', 'allowedEnd', 'weekdaysOnly',
               'dailyDigest', 'deadlineNudges', 'escalation', 'updatedAt'
             ]);
      }
      // notificationLog/* (send de-dupe) is server-only: no client access.
    }

    // Single-use notification action tokens: server-only (Admin SDK).
    match /notificationActions/{token} {
      allow read, write: if false;
    }

    // ─── Revenue Rollups ────────────────────────────────────────────────────────
    match /bdmStats/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }

    // ─── Strategy Documents ─────────────────────────────────────────────────────
    match /callPlans/{planId} {
      allow read: if isAdmin() || (isStaff() && (ownsExisting() || resource.data.get('userId', null) == 'TEAM_NODE'))
        || sharedWith('callPlans', 'factFinding');
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate() || (sharedWith('callPlans', 'factFinding') && keepsOwner());
      allow delete: if ownerDelete() || sharedWith('callPlans', 'factFinding');
    }

    match /callOutcomes/{outcomeId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /whitespacePlans/{planId} {
      allow read: if isAdmin() || (isStaff() && (ownsExisting() || resource.data.get('userId', null) == 'TEAM_NODE'))
        || sharedWith('whiteSpace', 'factFinding');
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate() || (sharedWith('whiteSpace', 'factFinding') && keepsOwner());
      allow delete: if ownerDelete() || sharedWith('whiteSpace', 'factFinding');
    }

    // ─── Pipeline & CRM Data ────────────────────────────────────────────────────
    match /pipelineReviews/{reviewId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if ownerDelete();
    }

    match /lostCustomers/{lostId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /crmActivities/{activityId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if ownerDelete();
    }

    // ─── Weekly Governance ──────────────────────────────────────────────────────
    match /weeklyCommitments/{docId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /weeklyProgress/{id} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if isAdmin();
    }

    match /weeklyActivity/{id} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if isAdmin();
    }

    // ─── Intelligence & Reporting ───────────────────────────────────────────────
    match /aiBriefs/{briefId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /weeklyReports/{reportId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if isAdmin();
    }

    // TWTW – the only data collection guests use (their own submission).
    match /twiwSubmissions/{submissionId} {
      allow read: if isAdmin() || ownsExisting();
      allow create: if createsOwn();
      allow update: if isAdmin() || (ownsExisting() && keepsOwner());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /opsReports/{reportId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if ownerDelete();
    }

    // ─── Friday Synthesis Data ──────────────────────────────────────────────────
    match /opportunities/{oppId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /signedPaperwork/{docId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /newBusiness/{docId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update, delete: if isAdmin();
    }

    match /weeklyGoals/{docId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if isAdmin();
    }

    // ─── Feature flags & telemetry ──────────────────────────────────────────────
    match /appSettings/featureFlags {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /telemetryEvents/{eventId} {
      allow create: if isStaff() && request.resource.data.get('userId', null) == request.auth.uid;
      allow read: if isAdmin();
    }

    // Only the client's increment shape is allowed, by staff.
    match /telemetryAggregates/{viewKey} {
      allow read: if isAdmin();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['viewKey', 'viewCount', 'lastUpdated'])
        && request.resource.data.viewKey == viewKey;
      allow delete: if isAdmin();
    }

    match /aiUsageLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /gmReports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /teamReports/{id} {
      allow read, write: if isAdmin();
    }

    // ─── Strategy & Progress ────────────────────────────────────────────────────
    match /monthlySmartGoals/{goalId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if ownerDelete();
    }

    match /coachingNotes/{userId} {
      allow read, write: if isAdmin() || (isStaff() && isOwner(userId));
      match /entries/{entryId} {
        allow read, write: if isAdmin() || (isStaff() && isOwner(userId));
      }
    }

    // Doc ids: "<uid>_<PLAN>" (personal) or "SHARED_<PLAN>" (team-wide).
    match /onboardingProgress/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin()
        || (isStaff() && (docId.matches('^' + request.auth.uid + '_.*') || docId.matches('^SHARED_.*')));
    }

    // ─── Success Plans ──────────────────────────────────────────────────────────
    match /successPlans/{planId} {
      allow read: if isAdmin() || (isStaff() && (resource.data.get('createdBy', null) == request.auth.uid || resource.data.get('teamMemberId', null) == request.auth.uid));
      allow create: if isAdmin() || (isStaff() && request.resource.data.get('createdBy', null) == request.auth.uid);
      allow update, delete: if isAdmin() || (isStaff() && (resource.data.get('createdBy', null) == request.auth.uid || resource.data.get('teamMemberId', null) == request.auth.uid));
    }

    // ─── System config ──────────────────────────────────────────────────────────
    // "current" = team broadcast; "nudge_<uid>" = targeted Team Nudge (only
    // that user and admins can read it).
    match /systemAnnouncements/{docId} {
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.get('targetUserId', null) == null
        || resource.data.get('targetUserId', null) == request.auth.uid
        || isAdmin()
      );
      allow write: if isAdmin();
    }

    match /strategyConfig/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // "global" = team settings (staff read); "<uid>" = personal settings.
    match /appSettings/{docId} {
      allow read: if isStaff() || isOwner(docId);
      allow write: if isAdmin() || isOwner(docId);
    }

    match /factFindingDocs/{docId} {
      allow read: if ownerRead() || sharedWith('factFinding', 'factFinding');
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate() || (sharedWith('factFinding', 'factFinding') && keepsOwner());
      allow delete: if ownerDelete() || sharedWith('factFinding', 'factFinding');
    }

    match /timeManagementPlans/{planId} {
      allow read: if ownerRead();
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate();
      allow delete: if ownerDelete();
    }

    // ─── Verticals prospects ─────────────────────────────────────────────────────
    // Staff read all. BDMs/admins source, claim, score, tag and convert.
    // AMs read all and may only edit growth notes on leads routed to them.
    // Claims lapse after 30 days with no activity (lastActivityAt).
    function isBdm() { return myRole() == 'BDM'; }
    function isAmRole() { return myRole() in ['ACCOUNT_MANAGER', 'AM']; }
    function optStr(d, k, maxLen) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= maxLen); }
    function optTs(d, k) { return !(k in d) || d[k] == null || d[k] is timestamp; }
    function optUid(d, k) { return !(k in d) || d[k] == null || d[k] is string; }
    function validProspect(d) {
      return d.keys().hasOnly([
          'company', 'vertical', 'belt', 'source', 'contactName', 'contactTitle',
          'freightProfile', 'notes', 'ownerUid', 'ownerName', 'claimedAt',
          'sfStatus', 'sfCheckedBy', 'sfCheckedAt', 'scores', 'score',
          'amUid', 'amName', 'amNotes', 'convertedAt', 'convertedBy',
          'createdBy', 'createdByName', 'createdAt', 'lastActivityAt',
          // Written only by the server (Admin SDK) intel route
          'painSignals', 'painCheckedAt'
        ])
        && d.company is string && d.company.size() > 0 && d.company.size() <= 200
        && d.vertical in ['MINING', 'MEDICAL', 'ECOMMERCE', 'OTHER']
        && d.belt in ['NORTH', 'EAST', 'SOUTH', 'CENTRAL', 'REGIONAL_WA', 'INTERSTATE']
        && d.get('source', 'OTHER') in ['AUSTMINE', 'CME', 'GOOGLE_MAPS', 'REFERRAL', 'TENDER', 'LINKEDIN', 'RESEARCH', 'LOOKALIKE', 'OTHER']
        && d.sfStatus in ['UNCHECKED', 'NOT_IN_SF', 'EXISTING_AM', 'LOST_DORMANT']
        && d.freightProfile is list && d.freightProfile.size() <= 5
        && d.freightProfile.hasOnly(['SATCHEL', 'PARCEL', 'CARTON', 'SKID', 'PALLET'])
        && d.score is int && d.score >= 0 && d.score <= 5
        && d.scores is map && d.scores.keys().hasOnly(['frequency', 'freightFit', 'regionalNeed', 'carrierPain', 'growth'])
        // Score needs an SF check first
        && (d.score == 0 || d.sfStatus != 'UNCHECKED')
        // Existing customers are AM opportunities: never BDM-claimed
        && (d.sfStatus != 'EXISTING_AM' || d.get('ownerUid', null) == null)
        && optStr(d, 'notes', 5000) && optStr(d, 'contactName', 200) && optStr(d, 'contactTitle', 200)
        && optStr(d, 'amNotes', 5000)
        && optStr(d, 'ownerName', 200) && optStr(d, 'amName', 200) && optStr(d, 'createdByName', 200)
        && optUid(d, 'ownerUid') && optUid(d, 'amUid') && optUid(d, 'sfCheckedBy')
        && optUid(d, 'convertedBy')
        && optTs(d, 'claimedAt') && optTs(d, 'sfCheckedAt') && optTs(d, 'convertedAt')
        && d.lastActivityAt is timestamp;
    }
    function prospectKeepsCreator() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }
    function prospectClaimLapsed() {
      return resource.data.lastActivityAt < request.time - duration.value(30, 'd');
    }
    function prospectOpenToMe() {
      return resource.data.get('ownerUid', null) == null || prospectClaimLapsed();
    }
    // A BDM may become (or stay) owner only once SF-checked and not an AM opportunity.
    function prospectOwnerOk() {
      return request.resource.data.get('ownerUid', null) == null
        || (request.resource.data.ownerUid == request.auth.uid
            && !(request.resource.data.sfStatus in ['UNCHECKED', 'EXISTING_AM']));
    }

    // Clients can never set or change server-written intel fields.
    function prospectIntelUnchanged() {
      return request.resource.data.get('painSignals', null) == resource.data.get('painSignals', null)
        && request.resource.data.get('painCheckedAt', null) == resource.data.get('painCheckedAt', null);
    }

    match /verticalProspects/{prospectId} {
      allow read: if isStaff();
      allow create: if (isBdm() || isAdmin())
        && validProspect(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && !('painSignals' in request.resource.data) && !('painCheckedAt' in request.resource.data)
        && (isAdmin() || prospectOwnerOk());
      allow update: if validProspect(request.resource.data) && prospectKeepsCreator() && prospectIntelUnchanged() && (
        isAdmin()
        // Current owner (claim not lapsed), or any BDM on an unclaimed/lapsed prospect (incl. claiming it)
        || (isBdm()
            && (resource.data.get('ownerUid', null) == request.auth.uid || prospectOpenToMe())
            && prospectOwnerOk())
        // Assigned AM: growth notes only
        || (isAmRole()
            && resource.data.get('amUid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amNotes', 'lastActivityAt']))
      );
      allow delete: if isAdmin() || (isBdm() && resource.data.get('ownerUid', null) == request.auth.uid);
    }

    // "Trading with TGE" markers: a suggested / lookalike company that is already a customer is
    // hidden from the suggestion lists for everyone. Doc ID = normalised company name
    // (lowercase letters + digits, matches normaliseCompany() in src/lib/verticals.ts).
    match /verticalDismissals/{key} {
      allow read: if isStaff();
      allow create: if isStaff()
        && key.matches('^[a-z0-9]{1,150}$')
        && request.resource.data.keys().hasOnly(['company', 'reason', 'suggestedId', 'dismissedBy', 'dismissedByName', 'dismissedAt'])
        && request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 200
        && request.resource.data.reason == 'TRADING_WITH_TGE'
        && request.resource.data.dismissedBy == request.auth.uid
        && request.resource.data.dismissedAt == request.time
        && optStr(request.resource.data, 'suggestedId', 200)
        && optStr(request.resource.data, 'dismissedByName', 200);
      allow update: if false;
      allow delete: if isStaff(); // undo / "show hidden"
    }

    // Server-only intel cache and per-user usage counters (Admin SDK bypasses rules).
    match /intelCache/{id} { allow read, write: if false; }
    match /intelUsage/{id} { allow read, write: if false; }

    // ─── Fuel surcharges ────────────────────────────────────────────────────
    // Scraped data + history: written only by the server (Admin SDK). Staff read.
    match /fuelSurcharges/{carrierId} { allow read: if isStaff(); allow write: if false; }
    match /fuelSurchargeHistory/{id} { allow read: if isStaff(); allow write: if false; }
    match /fuelSurchargeMeta/{id} { allow read, write: if false; }
    // Admin manual overrides (known rate-card values or corrections).
    match /fuelSurchargeOverrides/{carrierId} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && carrierId in ['tge', 'startrack', 'auspost', 'tnt', 'aramex', 'couriersplease', 'dhl', 'sendle',
                         'kal', 'direct', 'hunter', 'northline', 'border', 'allied', 'mainfreight', 'followmont', 'capital']
        && request.resource.data.keys().hasOnly(['pct', 'label', 'note', 'effective', 'enteredBy', 'enteredByName', 'enteredAt'])
        && request.resource.data.pct is number && request.resource.data.pct >= 0 && request.resource.data.pct < 100
        && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && (request.resource.data.effective == null || (request.resource.data.effective is string && request.resource.data.effective.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.enteredBy == request.auth.uid
        && request.resource.data.enteredByName is string && request.resource.data.enteredByName.size() <= 120
        && request.resource.data.enteredAt == request.time;
      allow delete: if isAdmin();
    }

    match /canvass_leads/{leadId} {
      allow read: if ownerRead() || sharedWith('canvassing', 'canvassing');
      allow create: if staffCreatesOwn();
      allow update: if ownerUpdate() || (sharedWith('canvassing', 'canvassing') && keepsOwner());
      allow delete: if ownerDelete() || sharedWith('canvassing', 'canvassing');
    }

    // ─── Commercial data (staff only; Actual Spend screen is open to BDMs) ──────
    match /actualRevenues/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /globalRates/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Assigning reps (Actual Spend / Align Customer) is admin-only, as before.
    match /accountMappings/{mappingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ─── AM/BD Targeted Notes ───────────────────────────────────────────────────
    match /ambdNotes/{noteId} {
      allow read: if ownerRead();
      allow create: if isAdmin();
      allow update: if isAdmin() || (ownsExisting() && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'readAt', 'updatedAt']));
      allow delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Core Auth Helpers ───────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '1@1.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role == 'LEADER' ||
          getUserData().role == 'GM'
        ))
      );
    }

    // ─── User Management ─────────────────────────────────────────────────────────
    // Anyone can read their own user doc; admins can read all.
    // Owners can update their own doc EXCEPT the role field (prevents self-escalation).
    // Only admins can create, set role, or delete.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if (
        isOwner(userId) && 
        request.resource.data.role == 'GUEST' && 
        request.resource.data.email.matches('.*@teamglobalexp\\.com$')
      ) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Revenue Rollups ─────────────────────────────────────────────────────────
    // Restricted to owner or admin — this data includes revenue targets.
    match /bdmStats/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }

    // ─── Strategy Documents ──────────────────────────────────────────────────────
    match /callPlans/{planId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /callOutcomes/{outcomeId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /whitespacePlans/{planId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // ─── Pipeline & CRM Data ─────────────────────────────────────────────────────
    match /pipelineReviews/{reviewId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /lostCustomers/{lostId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Weekly Governance Nodes ─────────────────────────────────────────────────
    match /weeklyCommitments/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /weeklyProgress/{id} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isSignedIn() && (resource == null || (resource == null || resource.data.userId == request.auth.uid) || isAdmin());
    }

    match /weeklyActivity/{id} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isSignedIn() && (resource == null || (resource == null || resource.data.userId == request.auth.uid) || isAdmin());
    }

    // ─── Intelligence & Reporting ─────────────────────────────────────────────────
    match /aiBriefs/{briefId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /weeklyReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /twiwSubmissions/{submissionId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /opsReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // ─── Friday Synthesis Data (BDM Weekly Submission) ───────────────────────────
    match /opportunities/{oppId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /signedPaperwork/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /newBusiness/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Weekly Goals (GM Report Generator) ──────────────────────────────────────
    match /weeklyGoals/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // ─── AI Usage Tracking ────────────────────────────────────────────────────────
    match /aiUsageLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /gmReports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamReports/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Strategy & Progress ─────────────────────────────────────────────────────
    match /monthlySmartGoals/{goalId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource == null || (resource == null || resource.data.userId == request.auth.uid)));
    }

    match /coachingNotes/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
      match /entries/{entryId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if isAdmin() || isOwner(userId);
      }
    }

    match /onboardingProgress/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Success Plans ────────────────────────────────────────────────────────────
    // Only the creator or an admin can read a plan.
    match /successPlans/{planId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && (resource.data.createdBy == request.auth.uid || resource.data.teamMemberId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource != null && (resource.data.createdBy == request.auth.uid || resource.data.teamMemberId == request.auth.uid));
    }

    // ─── System Config ────────────────────────────────────────────────────────────
    match /systemAnnouncements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /strategyConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && docId == request.auth.uid);
    }

    match /factFindingDocs/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /timeManagementPlans/{planId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /canvass_leads/{leadId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /actualRevenues/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── AM/BD Targeted Notes ──────────────────────────────────────────────────
    match /ambdNotes/{noteId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }
  }
}